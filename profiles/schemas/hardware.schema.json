{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oddcurrent/hardware-1.0.0",
  "type": "object",
  "required": ["schema_version", "profile_id", "friendly_name", "hardware", "pixels", "outputs", "buttons", "capabilities", "validation"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "profile_id": {"type":"string", "pattern":"^[a-z][a-z0-9-]+$"},
    "friendly_name": {"type":"string", "minLength":1},
    "capabilities": {"type":"array", "uniqueItems":true, "items":{"type":"string"}},
    "hardware": {"type":"object", "required":["mcu","flash_mb","psram_mb","board_carrier"]},
    "pixels": {"type":"object", "required":["type","voltage_v","estimated_total_min","estimated_total_max","mapping_status"],"properties":{"voltage_v":{"type":["number","null"],"minimum":0}}},
    "outputs": {"type":"array", "minItems":1, "items":{"type":"object", "required":["key","gpio","zones"], "properties":{"gpio":{"type":"integer","minimum":0,"maximum":48},"zones":{"type":"array","items":{"type":"string"}}}}},
    "buttons": {"type":"array", "items":{"type":"object", "required":["key","gpio"]}},
    "validation": {"type":"object", "required":["carrier","pixels","concurrent_peripherals","electrical","thermal"], "additionalProperties":{"type":"boolean"}}
  }
}
